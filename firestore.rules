rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    // Product validation
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.currency is string && data.currency.size() <= 20 &&
             data.shortDescription is string && data.shortDescription.size() <= 1000 &&
             data.description is string && data.description.size() <= 10000 &&
             (!('status' in data) || data.status in ['active', 'draft', 'archived']);
    }

    // Category validation
    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100 &&
             data.active is bool;
    }

    // Promotion validation
    function isValidPromotion(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.active is bool;
    }

    // Order validation
    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 250 &&
             data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 100 &&
             data.shippingAddress is string && data.shippingAddress.size() > 0 && data.shippingAddress.size() <= 1500 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'completed', 'cancelled'];
    }

    // Products Collection
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // Promotions Collection
    match /promotions/{promotionId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(promotionId) && isValidPromotion(incoming());
      allow update: if isAdmin() && isValidId(promotionId) && isValidPromotion(incoming());
      allow delete: if isAdmin() && isValidId(promotionId);
    }

    // Orders Collection
    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow get: if isValidId(orderId);
      allow list: if isAdmin();
      allow update: if isAdmin() && isValidId(orderId) && isValidOrder(incoming());
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Settings Collection (Social media channels & contact details)
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(settingId);
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // Spiritual Posts Collection
    match /spiritual/{postId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(postId);
      allow delete: if isAdmin() && isValidId(postId);
    }

    // Admins Collection
    match /admins/{adminUid} {
      allow get: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
